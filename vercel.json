{
  "redirects": [
    {
      "source": "/assets/:path*",
      "has": [{ "type": "header", "key": "sec-fetch-dest", "value": "document" }],
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noimageindex" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" }
      ]
    }
  ]
}
